PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Runtime DB connection. Use Supabase shared transaction-mode pooler for the app.
DATABASE_URL=postgresql://postgres.mkvgbffihswfjzgegwlx:YOUR-PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migration/direct connection, not used by this app yet.
DIRECT_URL=postgresql://postgres.mkvgbffihswfjzgegwlx:YOUR-PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# 오래된 완료 할 일 보관: 매년 ARCHIVE_MONTHS에 지정한 달(기본 6월·12월)에 한 번,
# 완료된 지 ARCHIVE_AFTER_MONTHS개월 지난 항목을 이메일로 export한 뒤 삭제.
# SMTP 설정이 없으면 기능이 꺼진다. Gmail이면 smtp.gmail.com + 앱 비밀번호를 쓴다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
ARCHIVE_MONTHS=6,12
ARCHIVE_AFTER_MONTHS=6
# 받는 사람: Supabase 로그인 사용자는 각자 계정 이메일로 감 (SERVICE_ROLE_KEY 필요).
# 파일 모드(로그인 없음)이거나 이메일 조회가 안 될 때의 대체 주소:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ARCHIVE_EMAIL_TO=you@gmail.com
